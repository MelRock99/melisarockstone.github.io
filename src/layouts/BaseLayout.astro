---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;

const {
  title = "MelisaRockStone Music",
  description = "Official site for MelisaRockStone Music — videos, events, and merch.",
} = Astro.props;

const email = "Melisarockstone@gmail.com";

const socials = {
  facebook: "https://www.facebook.com/57VortexRock",
  instagram: "https://www.instagram.com/melisarockstone/",
  tiktok: "https://www.tiktok.com/@melisarockstone.c",
  bluesky: "https://bsky.app/profile/melisarockstone.bsky.social",
  substack: "https://melisarockstone4real.substack.com",
  patreon: "https://www.patreon.com/cw/melisarockstone",
  x: "https://x.com/99VortexRock",
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <header>
      <div style="max-width:980px;margin:0 auto;padding:18px 16px;display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap;">
        <a href={base} style="font-weight:800;letter-spacing:.3px;">
          MelisaRockStone Music
        </a>

        <nav style="display:flex;gap:14px;flex-wrap:wrap;">
          <a href={base}>Home</a>
          <a href={`${base}events/`}>Events</a>
          <a href={`${base}contact/`}>Contact</a>
        </nav>
      </div>
    </header>

   
    </header>

    <main style="max-width:980px;margin:0 auto;padding:28px 16px;">
      <slot />
    </main>

<footer style="border-bottom:12px solid #3a3a3a;">
      <div style="max-width:980px;margin:0 auto;padding:18px 16px 34px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between;">

        <div style="font-size:14px;">
          © {new Date().getFullYear()} MelisaRockStone Music •
          <a href={`mailto:${email}`}>{email}</a>
        </div>

        <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:flex-end;align-items:center;">

          <a href={socials.facebook} target="_blank" rel="noreferrer"
             aria-label="Facebook" title="Facebook">
            <img src="https://cdn.simpleicons.org/facebook" alt="Facebook" width="24" height="24" />
          </a>

          <a href={socials.instagram} target="_blank" rel="noreferrer"
             aria-label="Instagram" title="Instagram">
            <img src="https://cdn.simpleicons.org/instagram" alt="Instagram" width="24" height="24" />
          </a>

          <a href={socials.tiktok} target="_blank" rel="noreferrer"
             aria-label="TikTok" title="TikTok">
            <img src="https://cdn.simpleicons.org/tiktok/ffffff" alt="TikTok" width="24" height="24" />
          </a>

          <a href={socials.bluesky} target="_blank" rel="me noreferrer"
             aria-label="Bluesky" title="Bluesky">
            <img src="https://cdn.simpleicons.org/bluesky" alt="Bluesky" width="24" height="24" />
          </a>

          <a href={socials.substack} target="_blank" rel="noreferrer"
             aria-label="Substack" title="Substack">
            <img src="https://cdn.simpleicons.org/substack" alt="Substack" width="24" height="24" />
          </a>

          <a href={socials.patreon} target="_blank" rel="noreferrer"
             aria-label="Patreon" title="Patreon">
            <img src="https://cdn.simpleicons.org/patreon/ffffff" alt="Patreon" width="24" height="24" />
          </a>

          <a href={socials.x} target="_blank" rel="noreferrer"
             aria-label="X" title="X">
            <img src="https://cdn.simpleicons.org/x/ffffff" alt="X" width="24" height="24" />
          </a>

        </div>
      </div>
    </footer>
</body>
</html>

 
